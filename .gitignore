# The production database — 44GB+, never belongs in git
*.duckdb
*.duckdb.wal
*.duckdb.backup_*
*.bak_*

# Python
__pycache__/
*.pyc
.venv/
*.egg-info/
dist/
build/

# Test/lint/coverage artifacts
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Local project state for a CLI consuming bukvarix (not this repo's own data)
.bukvarix/state.json
# mutmut's working copy and results (uv run --group mutation mutmut run)
mutants/
# Local env files hold keys: keys never go into the repo (the gate's secret scan)
.env
.env.*
# The root lines Antagor adds
.DS_Store
Thumbs.db
